#!/bin/sh
# honor-fmbp-dsdt-select — pick the DSDT variant matching this machine's BIOS SKU and
# point the canonical /usr/share/honor-fmbp/dsdt.aml symlink at it. The initramfs hook
# is deliberately dumb and just ships whatever that symlink resolves to.
#
# Generator-agnostic: this also keeps /usr/share/honor-fmbp/acpi/ populated with just
# the selected AML, which dracut consumes via acpi_table_dir (see the shipped
# /etc/dracut.conf.d/10-honor-fmbp-dsdt.conf). initramfs-tools ignores that dir and
# dracut ignores the hook, so exactly the active generator's mechanism fires.
#
# Why here and not in the hook: the FMB-P global and Chinese BIOSes carry identical DSDT
# logic but different NVS base addresses; applying the wrong variant would drive the ACPI
# override at the wrong memory. The SKU is fixed hardware, so we resolve it ONCE (at
# install, or when re-run by hand) instead of re-detecting on every kernel/initramfs rebuild.
#
# Detection: the GNVS SystemMemory OperationRegion base is 0x67E09018 (global) vs
# 0x67E19018 (Chinese). In AML that is a DWordConst — bytes "0c 18 90 e0 67" (global) or
# "0c 18 90 e1 67" (Chinese). We match those in the live firmware DSDT via an od hexdump +
# fixed-string grep: locale-independent, coreutils-only. (Do NOT use grep -P '\xNN' for
# this — under a UTF-8 locale it matches Unicode codepoints, not raw bytes, and silently
# finds nothing.)
#
# Only the FIRMWARE's own table tells the SKU. While an override is active (ours via the
# initramfs, colorcube's, or denis-bb's via GRUB `acpi`), /sys shows the override, which
# carries the addresses of whichever variant was loaded — so re-detecting from it would
# just echo an earlier (possibly wrong) choice back, or flip a correct one. Hence:
#   * firmware table live  -> detect; this is authoritative and may correct a selection.
#   * override live        -> keep the existing selection; with none yet (first install
#                             from the remastered ISO, or over a GRUB override) fall back
#                             to the variant the running override uses, and say so.
#   * detection impossible or ambiguous -> never drop or switch an existing selection.
# A selection is only removed when DMI positively identifies a different machine.
#
# Override: put "global" or "chinese" (or an empty file, meaning global) in
# /etc/honor-fmbp/dsdt-force to skip detection — e.g. a Chinese-variant firmware installed
# from the remastered ISO (which always boots the global table), or an image build on
# other hardware. The variant is not the sales region (colorcube issue #15).
set -e

SHARE=/usr/share/honor-fmbp
CANON="$SHARE/dsdt.aml"
ACPIDIR="$SHARE/acpi"           # dracut's acpi_table_dir: holds exactly the selected AML
FORCE=/etc/honor-fmbp/dsdt-force
TABLE=/sys/firmware/acpi/tables/DSDT

run_initramfs=1
[ "$1" = "--postinst" ] && run_initramfs=0   # postinst lets the dpkg initramfs trigger rebuild

log() { echo "honor-fmbp-dsdt: $*" >&2; }
warn() { log "WARNING: $*"; }

HEX=""
[ -r "$TABLE" ] && HEX=$(od -An -v -tx1 "$TABLE" | tr -s ' \n' ' ')
has() { case "$HEX" in *"$1"*) return 0 ;; esac; return 1; }

# SKU whose GNVS address the live table carries (firmware's or an override's).
table_sku() {
    if has '0c 18 90 e0 67'; then echo global
    elif has '0c 18 90 e1 67'; then echo chinese
    else return 1
    fi
}

# Is the live DSDT an override rather than the firmware's own table?
#   "TD_P" (54 44 5f 50): our injected touchscreen package — ours and colorcube's tables.
#   no "NFC0" (4e 46 43 30): denis-bb's table deletes the device; every firmware has it.
#   kernel log "Table Upgrade: override [DSDT": any initrd override (if the log has it).
live_is_override() {
    has '54 44 5f 50' && return 0
    has '4e 46 43 30' || return 0
    dmesg 2>/dev/null | grep -q 'Table Upgrade: override \[DSDT' && return 0
    return 1
}

# SKU of the existing selection ("" if none).
current_sku() {
    case "$(readlink "$CANON" 2>/dev/null || true)" in
        dsdt.global.aml)  echo global ;;
        dsdt.chinese.aml) echo chinese ;;
    esac
}

cur=$(current_sku)
sku=""          # what to select; stays "" -> no selection
remove=0        # 1 -> drop the selection (positively not an FMB-P)

if [ -e "$FORCE" ]; then
    sku=$(tr -d '[:space:]' < "$FORCE" 2>/dev/null || true)
    case "$sku" in
        global|chinese) log "SKU forced to '$sku' via $FORCE" ;;
        "")             sku=global; log "empty $FORCE -> forcing global DSDT" ;;
        *)              log "ERROR: unrecognised '$sku' in $FORCE (use global or chinese) -> nothing changed"
                        exit 1 ;;
    esac
else
    vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)
    product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
    if [ -z "$vendor" ] && [ -z "$product" ]; then
        # No DMI (container, chroot without /sys): we know nothing about this machine.
        if [ -n "$cur" ]; then
            sku=$cur; log "DMI unreadable -> keeping the existing $cur selection"
        else
            log "DMI unreadable -> no DSDT override selected"
            log "(create $FORCE to force a selection for image builds)"
        fi
    elif [ "$vendor" != "HONOR" ] || [ "$product" != "FMB-P" ]; then
        remove=1
        log "not an HONOR FMB-P (DMI: ${vendor:-?}/${product:-?}) -> no DSDT override selected"
        log "(create $FORCE to force a selection for image builds on other hardware)"
    elif [ -z "$HEX" ]; then
        if [ -n "$cur" ]; then
            sku=$cur; warn "cannot read $TABLE -> keeping the existing $cur selection"
        else
            sku=global
            warn "cannot read $TABLE -> defaulting to the global DSDT."
            warn "If the firmware is the Chinese variant: echo chinese | sudo tee $FORCE; sudo honor-fmbp-dsdt-select"
        fi
    elif ! live_is_override; then
        # The firmware's own table: authoritative.
        if sku=$(table_sku); then
            if [ -n "$cur" ] && [ "$cur" != "$sku" ]; then
                warn "firmware DSDT is the $sku variant but $cur was selected -> switching to $sku"
            else
                log "detected $sku SKU from the firmware DSDT"
            fi
        elif [ -n "$cur" ]; then
            sku=$cur
            warn "firmware DSDT matches no known SKU (new BIOS?) -> keeping the existing $cur selection"
        else
            sku=""
            warn "firmware DSDT matches no known SKU (new BIOS or memory layout?) -> NO override selected."
            warn "Without it this machine may boot without NVMe/touchpad. Build a table from your own"
            warn "firmware (dsdt/build.sh in the source repo) or force one: echo global | sudo tee $FORCE"
        fi
    else
        # An override is live; its addresses only reflect an earlier choice.
        if [ -n "$cur" ]; then
            sku=$cur; log "DSDT override active -> keeping the existing $cur selection"
        elif sku=$(table_sku); then
            warn "a DSDT override is active, so the SKU cannot be read from firmware -> using the"
            warn "variant the running override carries ($sku). If the firmware is in fact the other"
            warn "variant (the remastered ISO always boots the global table):"
            warn "  echo chinese | sudo tee $FORCE; sudo honor-fmbp-dsdt-select"
        else
            sku=global
            warn "a DSDT override with unknown addresses is active -> defaulting to the global DSDT."
            warn "If the firmware is the Chinese variant: echo chinese | sudo tee $FORCE; sudo honor-fmbp-dsdt-select"
        fi
    fi
fi

if [ -n "$sku" ]; then
    if [ ! -e "$SHARE/dsdt.$sku.aml" ]; then
        log "ERROR: $SHARE/dsdt.$sku.aml is missing — package broken"; exit 1
    fi
    ln -sf "dsdt.$sku.aml" "$CANON"                 # initramfs-tools hook copies this (deref)
    mkdir -p "$ACPIDIR"                             # dracut scans this dir for *.aml
    rm -f "$ACPIDIR"/*.aml
    # A real copy, NOT a symlink: dracut's DRACUT_CP is `cp -dfrp` (no-dereference), so a
    # symlink here would land in the early cpio dangling and the kernel would find no table.
    # Re-copied on every run so a package upgrade's new AML reaches dracut too.
    cp -f "$SHARE/dsdt.$sku.aml" "$ACPIDIR/dsdt.aml"
    log "selected $sku DSDT ($CANON -> dsdt.$sku.aml)"
elif [ "$remove" = 1 ] || [ -z "$cur" ]; then
    rm -f "$CANON"
    rm -rf "$ACPIDIR"                               # no dir => dracut's acpi_override guard skips
fi

# A DSDT loaded by GRUB — its `acpi` command, or a custom early initrd via
# GRUB_EARLY_INITRD_LINUX_CUSTOM (the usual hand-rolled workaround) — becomes the table
# our initrd override is compared against, and the kernel only applies an override with
# a HIGHER OEM revision. denis-bb's table carries 0x0b, ours 0x03: ours would be silently
# ignored (no touchscreen fix). Warn; editing the admin's GRUB config is left to them.
rev_of() { od -An -tu4 -j24 -N4 "$1" 2>/dev/null | tr -d ' '; }
if [ -n "$sku" ]; then
    grub_hits=""
    for f in /etc/grub.d/*_custom /boot/grub/custom.cfg; do
        [ -f "$f" ] && grep -Eq '^[[:space:]]*acpi[[:space:]]' "$f" && grub_hits="$grub_hits $f"
    done
    for f in /etc/default/grub /etc/default/grub.d/*.cfg; do
        [ -f "$f" ] && grep -Eq "^[[:space:]]*GRUB_EARLY_INITRD_LINUX_CUSTOM=[\"']?[^\"'[:space:]]" "$f" \
            && grub_hits="$grub_hits $f"
    done
    ours_rev=$(rev_of "$SHARE/dsdt.$sku.aml"); live_rev=$(rev_of "$TABLE")
    shadowed=0
    if [ -n "$HEX" ] && [ -n "$ours_rev" ] && [ -n "$live_rev" ] && live_is_override \
       && [ "$live_rev" -ge "$ours_rev" ] \
       && ! { has '54 44 5f 50' && [ "$live_rev" -eq "$ours_rev" ]; }; then
        shadowed=1     # a foreign override at >= our revision (ours or colorcube's at = is fine)
    fi
    if [ "$shadowed" = 1 ] || [ -n "$grub_hits" ]; then
        warn "another DSDT override is loaded before this package's (OEM revision live: ${live_rev:-?},"
        warn "ours: ${ours_rev:-?}). The kernel applies ours only if its revision is higher, so"
        warn "the corrected table (incl. the touchscreen fix) may be IGNORED."
        [ -n "$grub_hits" ] && warn "GRUB loads a table via:$grub_hits"
        warn "Remove that GRUB 'acpi' line / GRUB_EARLY_INITRD_LINUX_CUSTOM entry, run"
        warn "'sudo update-grub' and reboot. This package's initramfs already carries the fix."
    fi
fi

# Rebuild the initramfs so the change takes effect. On Ubuntu both generators are
# mutually exclusive and the active one owns update-initramfs (dracut ships a shim),
# so this single call is generator-agnostic; fall back to dracut directly if only
# dracut-core (no shim) is present.
if [ "$run_initramfs" = "1" ]; then
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -u
    elif command -v dracut >/dev/null 2>&1; then
        dracut --force --regenerate-all
    fi
fi
