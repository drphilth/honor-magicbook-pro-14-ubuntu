#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # The canonical symlink and the dracut acpi_table_dir are created at runtime by
        # honor-fmbp-dsdt-select, so dpkg does not track them; drop the now-dangling link
        # and the dir when the variants are removed (a later initramfs rebuild then drops
        # the override on either generator).
        rm -f /usr/share/honor-fmbp/dsdt.aml
        rm -rf /usr/share/honor-fmbp/acpi
        ;;
esac

if [ "$1" = purge ]; then
    # Admin-created settings (SKU force, removal opt-in); purge means forget them.
    rm -f /etc/honor-fmbp/dsdt-force /etc/honor-fmbp/allow-dsdt-removal
    rmdir /etc/honor-fmbp 2>/dev/null || true
fi

#DEBHELPER#

exit 0
